---
import Base from "../layouts/Base.astro";
import { lifecycleRows, trendQueue, loadAll } from "../lib/data.js";
import TermCard from "../components/TermCard.astro";
const rows = lifecycleRows();
const queue = trendQueue();
const { byId } = loadAll();
const aesthetics = [
  "acid-graphics",
  "frutiger-aero",
  "vaporwave",
  "y2k-aesthetic",
].map((id) => byId.get(id));
---

<Base title="Trending" current="trending">
  <header class="page-heading">
    <p class="meta">Aesthetics in circulation</p>
    <h1>
      Watch the vocabulary change<span class="red-period">.</span>
    </h1>
    <p>
      Explore digital aesthetics and the research queue. A familiar style is not
      automatically a current trend.
    </p>
  </header>
  <section>
    <h2>Digital aesthetics.</h2>
    <p class="meta">
      Selected for exploration. This selection is not a popularity ranking.
    </p>
    <div class="grid">
      {aesthetics.map((term) => (
        <TermCard term={term} />
      ))}
    </div>
  </section>
  <section class="related-section">
    <h2>Tracked lifecycle reviews.</h2>
    {rows.length ? (
      rows.map(({ term, state, review_due, flag }) => (
        <article class="trend-entry">
          <h3>
            <a href={`/term/${term.id}/`}>{term.names.primary} ↗</a>
          </h3>
          <p>
            {state} / Review: {review_due ?? "not scheduled"} / {flag}
          </p>
        </article>
      ))
    ) : (
      <p class="reference-note">
        No current trend claims have a completed review record. Explore the
        aesthetics above while new evidence is gathered.
      </p>
    )}
  </section>
  <section class="related-section">
    <h2>Research queue.</h2>
    <p class="meta">
      {queue.counts.pending} candidates awaiting review. Inclusion is a research
      lead, not an endorsement or evidence of a trend.
    </p>
    {queue.pending.slice(0, 30).map((c) => (
      <article class="trend-entry">
        <h3>
          <a href={c.url}>{c.title ?? c.name ?? c.url} ↗</a>
        </h3>
        <p>{c.source ?? ""}</p>
      </article>
    ))}
  </section>
</Base>
