---
import Base from '../layouts/Base.astro';
import { loadAll, lifecycleRows, trendQueue } from '../lib/data.js';

const { byId } = loadAll();
const rows = lifecycleRows();
const { pending, counts } = trendQueue();
const recent = pending.slice(-30).reverse();
---
<Base title="Trending" current="trending">
  <h1>Trending</h1>
  <p class="meta">
    Nothing on this page publishes itself. Tracked terms carry review dates.
    Feed candidates wait in a queue until a human accepts or dismisses them.
  </p>

  <section>
    <h2>Tracked lifecycle states</h2>
    {rows.length ? (
      <table>
        <thead><tr><th>Term</th><th>State</th><th>Review due</th><th>Status</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td><a href={`/term/${r.term.id}/`}>{r.term.names?.primary ?? r.term.id}</a></td>
              <td class="value">{r.state}</td>
              <td class="value">{r.review_due ?? '(none)'}</td>
              <td>
                {r.flag === 'ok'
                  ? <span class="chip">ok</span>
                  : <span class="chip warn">{r.flag}: needs a human review date</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p class="meta">No terms are in a tracked state (emerging, peaking, saturated).</p>
    )}
  </section>

  <section>
    <h2>Candidate queue</h2>
    <p class="meta">
      {counts.pending} pending, {counts.accepted} accepted, {counts.dismissed} dismissed.
      Triage lives in trends/queue.yaml, not here.
    </p>
    {recent.length ? (
      <table>
        <thead><tr><th>Seen</th><th>Item</th><th>Feed</th></tr></thead>
        <tbody>
          {recent.map((c) => (
            <tr>
              <td class="value">{c.published_at ?? c.first_seen}</td>
              <td><a href={c.url}>{c.title}</a></td>
              <td class="value">{c.source}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p class="meta">Queue is empty. Run the collector to fetch candidates.</p>
    )}
  </section>
</Base>
