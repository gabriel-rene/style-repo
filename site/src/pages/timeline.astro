---
import Base from '../layouts/Base.astro';
import { loadAll, eraSpan } from '../lib/data.js';

const { terms } = loadAll();
const dated = terms
  .map((t) => ({ t, span: eraSpan(t) }))
  .filter((r) => r.span && Number.isInteger(r.span.start))
  .sort((a, b) => a.span.start - b.span.start);
const undated = terms.filter((t) => !dated.some((r) => r.t.id === t.id));

const min = dated.length ? Math.min(...dated.map((r) => r.span.start)) : 0;
const max = new Date().getFullYear();
const pct = (y) => ((y - min) / (max - min)) * 100;
---
<Base title="Timeline" current="timeline">
  <h1>Timeline</h1>
  <p class="meta">
    Only harvested dates appear here. A term with no sourced date stays in the
    "not dated yet" list. We do not guess.
  </p>

  {dated.length > 0 && (
    <section>
      <div class="tl-scale" aria-hidden="true"><span>{min}</span><span>{max}</span></div>
      {dated.map(({ t, span }) => {
        const left = pct(span.start);
        const right = span.end ? pct(span.end) : null;
        return (
          <div class="tl-row">
            <a href={`/term/${t.id}/`}>{t.names?.primary ?? t.id}</a>
            <div class="tl-track">
              <div
                class={`tl-bar${span.end ? '' : ' open-ended'}`}
                style={`left:${left}%; width:${span.end ? Math.max(right - left, 1) : Math.min(100 - left, 12)}%`}
                title={`${span.start ?? '?'} to ${span.end ?? 'no sourced end date'}`}
              />
            </div>
          </div>
        );
      })}
    </section>
  )}

  <section>
    <h2>Not dated yet ({undated.length})</h2>
    <p class="meta">These terms have no harvested period. Each needs a sourced date before it can join the chart above.</p>
    <p>
      {undated.map((t) => <a class="chip" href={`/term/${t.id}/`}>{t.names?.primary ?? t.id}</a>)}
    </p>
  </section>
</Base>
