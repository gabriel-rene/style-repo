---
import Base from "../layouts/Base.astro";
import { loadAll, eraSpan, typeLabel, description } from "../lib/data.js";
const { terms } = loadAll();
const dated = terms
  .map((t) => ({ t, span: eraSpan(t) }))
  .filter((r) => Number.isInteger(r.span?.start))
  .sort((a, b) => a.span.start - b.span.start);
const undated = terms.filter((t) => !dated.some((r) => r.t.id === t.id));
const min = Math.min(...dated.map((r) => r.span.start));
const max = Math.max(
  new Date().getFullYear(),
  ...dated.map((r) => r.span.end ?? r.span.start),
);
---

<Base title="Timeline" current="timeline">
  <header class="page-heading">
    <p class="meta">Design in context</p>
    <h1>
      Across time.
      <br />
      Never in isolation<span class="red-period">.</span>
    </h1>
    <p>
      Movements overlap. Processes endure. Explore the recorded periods, with
      approximate dates identified and sources on every entry.
    </p>
  </header>
  <div class="results-meta">
    <span>{dated.length} dated entries</span>
    <span>
      {min}–{max}
    </span>
  </div>
  <div class="timeline-list">
    {dated.map(({ t, span }) => (
      <article class="timeline-row">
        <div class="timeline-date">
          {span.periods.some((p) => p.approximate) ? "c. " : ""}
          {span.start}
          <div class="meta">
            {span.end ? `to ${span.end}` : "no recorded end date"}
          </div>
        </div>
        <div>
          <p class="meta">{typeLabel(t.term_type)}</p>
          <h2>
            <a href={`/term/${t.id}/`}>{t.names.primary} ↗</a>
          </h2>
          <p>{description(t)}</p>
        </div>
        <div>
          <div class="period-bars" aria-hidden="true">
            <span
              class="period-bar"
              style={`margin-left:${((span.start - min) / (max - min)) * 100}%;width:${Math.max(1, (((span.end ?? span.start) - span.start) / (max - min)) * 100)}%`}
            ></span>
          </div>
        </div>
      </article>
    ))}
  </div>
  <section class="timeline-undated">
    <h2>Beyond the dated record.</h2>
    <p class="meta">
      {undated.length} entries have a visual guide but no sourced period
      recorded. Missing dates do not imply a recent origin.
    </p>
    {undated.map((t) => (
      <a class="chip" href={`/term/${t.id}/`}>
        {t.names.primary}
      </a>
    ))}
  </section>
</Base>
